# ==========================================
# Environment Variables Configuration
# ==========================================
# Copy this file to .env and configure before starting the app.
# The proxy uses strict validation (Zod) on startup - missing or malformed
# variables will abort startup with a descriptive error message.

# --- App Settings ---
NODE_ENV=development
PORT=8080

# --- PostgreSQL Database ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/async_proxy

# --- Redis & BullMQ ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=

# Redis Cluster mode (optional). Set REDIS_CLUSTER_MODE=true and provide a
# comma-separated list of seed nodes to enable cluster support.
# REDIS_CLUSTER_MODE=false
# REDIS_CLUSTER_NODES=localhost:7000,localhost:7001,localhost:7002

# --- Maintenance: Timeout Sweeper ---
# Cron schedule (UTC) for the job that marks timed-out PROCESSING tasks as FAILED.
# Default: every minute. Adjust for lower-frequency environments if needed.
# TIMEOUT_SWEEPER_CRON=* * * * *

# --- Maintenance: Data Retention ---
# How many days to retain completed/failed/cancelled tasks before deletion.
# Covers both the `tasks` and `task_events` tables.
# DATA_RETENTION_DAYS=30

# Cron schedule (UTC) for the data-retention deletion job.
# Default: 03:00 UTC daily - low-traffic window for most deployments.
# Adjust if your peak-traffic hours overlap with 03:00 UTC.
# DATA_RETENTION_CRON=0 3 * * *