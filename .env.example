# ==========================================
# Environment Variables Configuration
# ==========================================
# Copy this file to .env and configure before starting the app.
# The proxy uses strict validation (Zod) on startup.

# --- App Settings ---
NODE_ENV=development
PORT=8080

# --- PostgreSQL Database ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/async_proxy

# --- Redis & BullMQ ---
# Used for queues, idempotency locks, and rate limiting
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=
REDIS_DB=0