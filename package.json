{
  "name": "async-long-request-proxy",
  "version": "1.0.0",
  "description": "Production-grade proxy for executing long-running HTTP requests using the Double 202 pattern.",
  "type": "module",
  "imports": {
    "#libs/*": "./dist/libs/*",
    "#src/*": "./dist/src/*"
  },
  "author": "exec-unit",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/exec-unit/async-long-request-proxy.git"
  },
  "keywords": [
    "async-http-proxy",
    "long-running-requests",
    "http-timeout-workaround",
    "webhook-dispatcher",
    "async-api-gateway",
    "server-sent-events",
    "idempotency-key",
    "double-202",
    "task-orchestrator",
    "bullmq-rest-api",
    "event-sourcing",
    "background-tasks"
  ],
  "scripts": {
    "prepare": "husky",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:build": "tsc --noEmit -p tsconfig.build.json",
    "build": "swc src libs -d dist",
    "dev:build": "swc src libs -d dist -w",
    "format": "prettier --write \"{src,libs,test}/**/*.ts\"",
    "format:check": "prettier --check \"{src,libs,test}/**/*.ts\"",
    "lint:fix": "eslint \"{src,libs,test}/**/*.ts\" --fix",
    "lint": "eslint \"{src,libs,test}/**/*.ts\"",
    "start": "node --enable-source-maps dist/src/main.js",
    "start:dev": "concurrently -k \"pnpm dev:build\" \"wait-on dist/src/main.js && node --enable-source-maps --watch --env-file=.env dist/src/main.js\"",
    "start:debug": "concurrently -k \"pnpm dev:build\" \"wait-on dist/src/main.js && node --enable-source-maps --watch --inspect=0.0.0.0:9229 --env-file=.env dist/src/main.js\"",
    "start:prod": "node --enable-source-maps dist/src/main.js",
    "worker": "node --enable-source-maps dist/src/worker.js",
    "worker:dev": "concurrently -k \"pnpm dev:build\" \"wait-on dist/src/worker.js && node --enable-source-maps --watch --env-file=.env dist/src/worker.js\"",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config ./test/jest-e2e.json"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/swagger": "^11.4.6",
    "@nestjs/terminus": "^11.1.1",
    "@willsoto/nestjs-prometheus": "^6.1.0",
    "bullmq": "^6.0.5",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "ioredis": "^6.0.0",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/testing": "^11.0.1",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.15.47",
    "@swc/jest": "^0.2.39",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "chokidar": "^5.0.0",
    "concurrently": "^10.0.4",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "husky": "^9.1.7",
    "jest": "^30.0.0",
    "lint-staged": "^17.3.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.4.2",
    "supertest": "^7.0.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "wait-on": "^9.1.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "@swc/jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.9.0",
      "onFail": "download"
    }
  }
}
